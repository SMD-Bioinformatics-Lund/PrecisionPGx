/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running at CGU
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Infrastructure only: can be combined with other profiles.

    Use as follows:
        nextflow run . -profile test_bam,cgu --outdir <OUTDIR>
        nextflow run . -profile cgu -params-file params.yaml --input samplesheet.csv --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'
    queue    = 'core'   // Standard priority; hi/akut later if needed in production

    // 'core' nodes: 40 CPUs, ~376 GB (385458 MB), no time limit.
    // Memory is kept below the node total to leave room for the system.
    resourceLimits = [
        cpus: 40,
        memory: 360.GB,
        time: 7.d
    ]
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}

apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/beegfs-storage/projects/wp3/nobackup/Workspace/julia_testing/singularity_cache'
}

conda.enabled           = false
docker.enabled          = false
singularity.enabled     = false
podman.enabled          = false
shifter.enabled         = false
charliecloud.enabled    = false
