/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs one GIAB HG002 sample (FASTQ split into two lanes, PGx target regions only)
    through the whole pipeline: alignment, lane merging, QC, DeepVariant, PharmCAT
    and CYP2D6 calling.

    Create the test data first (see docs/usage.md):
        bash test-datasets/make_test_data.sh

    Use as follows:
        nextflow run . -profile test,<singularity/docker> --outdir <OUTDIR>

    The reference is the full GRCh38 genome. Pass existing indices with
    --bwamem2 and --bwa to skip building them.

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name             = 'Test profile - FASTQ'
    config_profile_description      = 'GIAB HG002 reads over the PGx targets, run from FASTQ'

    // Created by test-datasets/make_test_data.sh
    pipelines_testdata_base_path    = "${projectDir}/test-datasets/data"
    input                           = "${params.pipelines_testdata_base_path}/samplesheet_fastq.csv"

    // Reference genome
    genome                          = 'GRCh38'
    igenomes_ignore                 = true
    fasta                           = "${params.pipelines_testdata_base_path}/reference/genome.fa"
    fai                             = "${params.pipelines_testdata_base_path}/reference/genome.fa.fai"
    target_bed                      = "${projectDir}/assets/panpgx.TE-97619858.grch38.refseq_mane.whole_genes_snps.annot.v2.bed"
    bait_padding                    = 50

    // Analysis
    analysis_type                   = 'panel'
    aligner                         = 'bwamem2'
    variant_caller                  = 'deepvariant'
    filter_vcf                      = true
    min_dp                          = 20    // The test data is ~60x WGS, below the panel default of 50
    skip_subworkflows               = 'hla_calling,cnv_calling'

    // PharmCAT reference genome
    pharmcat_reference_fasta        = "${params.pipelines_testdata_base_path}/pharmcat_reference.fna.bgz"
    pharmcat_reference_fasta_index  = "${params.pipelines_testdata_base_path}/pharmcat_reference.fna.bgz.gzi"
    pharmcat_reference_fasta_fai    = "${params.pipelines_testdata_base_path}/pharmcat_reference.fna.bgz.fai"
}
