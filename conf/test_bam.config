/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests from bam files
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as the test profile, but starts from an aligned BAM so alignment is
    skipped. This is the quickest way to check the pipeline end to end.

    Create the test data first (see docs/usage.md):
        bash test-datasets/make_test_data.sh

    Use as follows:
        nextflow run . -profile test_bam,<singularity/docker> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name             = 'Test profile - BAM'
    config_profile_description      = 'GIAB HG002 reads over the PGx targets, run from BAM'

    input                           = "${params.pipelines_testdata_base_path}/samplesheet_bam.csv"

    // PREPARE_REFERENCES builds bwa/bwa-mem2 indices whenever these are unset, even
    // for BAM input. Pointing them at an existing directory skips that step; the
    // indices are never used because there are no reads to align.
    bwa                             = params.pipelines_testdata_base_path
    bwamem2                         = params.pipelines_testdata_base_path
}
